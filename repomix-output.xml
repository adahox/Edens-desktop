#include "windowmanager.hpp"

#include <cstdlib>
#include <iostream>

namespace {

constexpr uint16_t kTitleBarHeight = 32;
constexpr uint16_t kButtonSize = 18;
constexpr uint16_t kButtonGap = 6;
constexpr uint16_t kButtonMargin = 8;

enum class TitleButton {
    None,
    Minimize,
    Maximize,
    Close
};

struct TitleButtonLayout {
    int16_t x = 0;
    int16_t y = 0;
};

struct TitleBarButtons {
    TitleButtonLayout minimize;
    TitleButtonLayout maximize;
    TitleButtonLayout close;
};

TitleBarButtons titleBarButtons(uint16_t frameWidth)
{
    const int16_t y = static_cast<int16_t>(
        (kTitleBarHeight - kButtonSize) / 2);
    const int16_t closeX = static_cast<int16_t>(
        frameWidth - kButtonMargin - kButtonSize);
    const int16_t maximizeX = static_cast<int16_t>(
        closeX - kButtonGap - kButtonSize);
    const int16_t minimizeX = static_cast<int16_t>(
        maximizeX - kButtonGap - kButtonSize);

    return {
        {minimizeX, y},
        {maximizeX, y},
        {closeX, y}
    };
}

bool containsButton(const TitleButtonLayout& button, int16_t x, int16_t y)
{
    return x >= button.x &&
           x < button.x + static_cast<int16_t>(kButtonSize) &&
           y >= button.y &&
           y < button.y + static_cast<int16_t>(kButtonSize);
}

TitleButton titleButtonAt(uint16_t frameWidth, int16_t x, int16_t y)
{
    if (y < 0 || y >= static_cast<int16_t>(kTitleBarHeight)) {
        return TitleButton::None;
    }

    const TitleBarButtons buttons = titleBarButtons(frameWidth);

    if (containsButton(buttons.close, x, y)) {
        return TitleButton::Close;
    }

    if (containsButton(buttons.maximize, x, y)) {
        return TitleButton::Maximize;
    }

    if (containsButton(buttons.minimize, x, y)) {
        return TitleButton::Minimize;
    }

    return TitleButton::None;
}

uint32_t colorPixel(
    xcb_connection_t* connection,
    xcb_colormap_t colormap,
    uint16_t red,
    uint16_t green,
    uint16_t blue,
    uint32_t fallback)
{
    const auto cookie = xcb_alloc_color(
        connection,
        colormap,
        red,
        green,
        blue);

    xcb_alloc_color_reply_t* reply =
        xcb_alloc_color_reply(connection, cookie, nullptr);

    if (reply == nullptr) {
        return fallback;
    }

    const uint32_t pixel = reply->pixel;
    std::free(reply);
    return pixel;
}

void fillButton(
    xcb_connection_t* connection,
    xcb_window_t frame,
    xcb_gcontext_t gc,
    const TitleButtonLayout& button)
{
    const xcb_rectangle_t rectangle = {
        button.x,
        button.y,
        kButtonSize,
        kButtonSize
    };

    xcb_poly_fill_rectangle(connection, frame, gc, 1, &rectangle);
}

void drawMinimizeGlyph(
    xcb_connection_t* connection,
    xcb_window_t frame,
    xcb_gcontext_t gc,
    const TitleButtonLayout& button)
{
    const int16_t y = static_cast<int16_t>(button.y + (kButtonSize / 2));
    const xcb_segment_t segment = {
        static_cast<int16_t>(button.x + 5),
        y,
        static_cast<int16_t>(button.x + kButtonSize - 5),
        y
    };

    xcb_poly_segment(connection, frame, gc, 1, &segment);
}

void drawMaximizeGlyph(
    xcb_connection_t* connection,
    xcb_window_t frame,
    xcb_gcontext_t gc,
    const TitleButtonLayout& button,
    bool maximized)
{
    if (maximized) {
        const xcb_rectangle_t back = {
            static_cast<int16_t>(button.x + 7),
            static_cast<int16_t>(button.y + 4),
            8,
            8
        };
        const xcb_rectangle_t front = {
            static_cast<int16_t>(button.x + 4),
            static_cast<int16_t>(button.y + 7),
            8,
            8
        };

        xcb_poly_rectangle(connection, frame, gc, 1, &back);
        xcb_poly_rectangle(connection, frame, gc, 1, &front);
        return;
    }

    const xcb_rectangle_t rectangle = {
        static_cast<int16_t>(button.x + 4),
        static_cast<int16_t>(button.y + 4),
        static_cast<uint16_t>(kButtonSize - 8),
        static_cast<uint16_t>(kButtonSize - 8)
    };

    xcb_poly_rectangle(connection, frame, gc, 1, &rectangle);
}

void drawCloseGlyph(
    xcb_connection_t* connection,
    xcb_window_t frame,
    xcb_gcontext_t gc,
    const TitleButtonLayout& button)
{
    const int16_t left = static_cast<int16_t>(button.x + 5);
    const int16_t right = static_cast<int16_t>(button.x + kButtonSize - 5);
    const int16_t top = static_cast<int16_t>(button.y + 5);
    const int16_t bottom = static_cast<int16_t>(button.y + kButtonSize - 5);

    const xcb_segment_t segments[] = {
        {left, top, right, bottom},
        {right, top, left, bottom}
    };

    xcb_poly_segment(connection, frame, gc, 2, segments);
}

uint32_t packedCoordinate(int16_t value)
{
    return static_cast<uint32_t>(static_cast<int32_t>(value));
}

}  // namespace

WindowManager::~WindowManager()
{
    disconnect();
}

bool WindowManager::connect()
{
    if (isConnected()) {
        return true;
    }

    disconnect();

    int screenNumber = 0;
    connection_ = xcb_connect(nullptr, &screenNumber);

    if (connection_ == nullptr ||
        xcb_connection_has_error(connection_) != 0) {
        disconnect();
        return false;
    }

    const xcb_setup_t* setup = xcb_get_setup(connection_);

    if (setup == nullptr) {
        disconnect();
        return false;
    }

    xcb_screen_iterator_t iterator =
        xcb_setup_roots_iterator(setup);

    for (int index = 0;
         index < screenNumber && iterator.rem;
         ++index) {
        xcb_screen_next(&iterator);
    }

    if (!iterator.rem || iterator.data == nullptr) {
        disconnect();
        return false;
    }

    screen_ = iterator.data;

    return true;
}

bool WindowManager::acquireControl()
{
    if (!isConnected()) {
        return false;
    }

    if (controlAcquired_) {
        return true;
    }

    const uint32_t eventMask =
        XCB_EVENT_MASK_SUBSTRUCTURE_REDIRECT |
        XCB_EVENT_MASK_SUBSTRUCTURE_NOTIFY;

    const auto cookie = xcb_change_window_attributes_checked(
        connection_,
        screen_->root,
        XCB_CW_EVENT_MASK,
        &eventMask
    );

    xcb_generic_error_t* error =
        xcb_request_check(connection_, cookie);

    if (error != nullptr) {
        std::free(error);
        return false;
    }

    controlAcquired_ = true;
    return true;
}

void WindowManager::disconnect()
{
    controlAcquired_ = false;
    screen_ = nullptr;
    wmProtocols_ = XCB_ATOM_NONE;
    wmDeleteWindow_ = XCB_ATOM_NONE;
    wmTakeFocus_ = XCB_ATOM_NONE;
    focusedFrame_ = XCB_WINDOW_NONE;
    draggingFrame_ = XCB_WINDOW_NONE;
    windows_.clear();

    if (connection_ != nullptr) {
        xcb_disconnect(connection_);
        connection_ = nullptr;
    }
}

bool WindowManager::isConnected() const noexcept
{
    return connection_ != nullptr &&
           xcb_connection_has_error(connection_) == 0 &&
           screen_ != nullptr;
}

void WindowManager::run()
{
    if (!isConnected() || !controlAcquired_) {
        std::cerr
            << "O WindowManager precisa estar conectado "
            << "e ter adquirido o controle.\n";
        return;
    }

    running_ = true;

    std::cout << "Eden WindowManager ativo. Pressione Ctrl+C para sair.\n";

    while (running_) {
        xcb_generic_event_t* event =
            xcb_wait_for_event(connection_);

        if (event == nullptr) {
            if (xcb_connection_has_error(connection_) != 0) {
                std::cerr << "A conexão X11 foi encerrada.\n";
                break;
            }

            continue;
        }

        handleEvent(event);
        std::free(event);
    }

    running_ = false;
}

void WindowManager::stop()
{
    running_ = false;
}


bool WindowManager::manageWindow(xcb_window_t client)
{
    if (!isConnected() || windows_.contains(client)) {
        return false;
    }

    const auto geometryCookie =
        xcb_get_geometry(connection_, client);

    xcb_generic_error_t* geometryError = nullptr;
    xcb_get_geometry_reply_t* geometry =
        xcb_get_geometry_reply(
            connection_,
            geometryCookie,
            &geometryError
        );

    if (geometryError != nullptr || geometry == nullptr) {
        std::free(geometryError);
        std::free(geometry);
        return false;
    }

    const uint16_t width = geometry->width;
    const uint16_t height = geometry->height;
    const int16_t x = geometry->x;
    const int16_t y = geometry->y;

    std::free(geometry);

    const xcb_window_t frame = xcb_generate_id(connection_);
    const uint32_t frameValues[] = {
        screen_->black_pixel,
        XCB_EVENT_MASK_BUTTON_PRESS
    };

    xcb_create_window(
        connection_,
        XCB_COPY_FROM_PARENT,
        frame,
        screen_->root,
        x,
        y,
        width,
        height + kTitleBarHeight,
        0,
        XCB_WINDOW_CLASS_INPUT_OUTPUT,
        screen_->root_visual,
        XCB_CW_BACK_PIXEL | XCB_CW_EVENT_MASK,
        frameValues
    );

    const xcb_window_t titleBar = xcb_generate_id(connection_);
    const uint32_t titleBarValues[] = {
        screen_->black_pixel,
        XCB_EVENT_MASK_EXPOSURE |
            XCB_EVENT_MASK_BUTTON_PRESS |
            XCB_EVENT_MASK_BUTTON_RELEASE |
            XCB_EVENT_MASK_POINTER_MOTION
    };

    xcb_create_window(
        connection_,
        XCB_COPY_FROM_PARENT,
        titleBar,
        frame,
        0,
        0,
        width,
        kTitleBarHeight,
        0,
        XCB_WINDOW_CLASS_INPUT_OUTPUT,
        screen_->root_visual,
        XCB_CW_BACK_PIXEL | XCB_CW_EVENT_MASK,
        titleBarValues
    );

    xcb_reparent_window(
        connection_,
        client,
        frame,
        0,
        kTitleBarHeight
    );

    const uint32_t clientEventMask =
        XCB_EVENT_MASK_STRUCTURE_NOTIFY |
        XCB_EVENT_MASK_BUTTON_PRESS;

    xcb_change_window_attributes(
        connection_,
        client,
        XCB_CW_EVENT_MASK,
        &clientEventMask
    );

    for (uint8_t button = XCB_BUTTON_INDEX_1;
         button <= XCB_BUTTON_INDEX_3;
         ++button) {
        xcb_grab_button(
            connection_,
            0,
            client,
            XCB_EVENT_MASK_BUTTON_PRESS,
            XCB_GRAB_MODE_SYNC,
            XCB_GRAB_MODE_ASYNC,
            XCB_WINDOW_NONE,
            XCB_CURSOR_NONE,
            button,
            XCB_MOD_MASK_ANY
        );
    }


    xcb_map_window(connection_, titleBar);
    xcb_map_window(connection_, client);
    xcb_map_window(connection_, frame);

    ManagedWindow& managed =
        windows_.emplace(client, ManagedWindow{client, frame, titleBar})
            .first->second;

    focusWindow(managed, XCB_CURRENT_TIME);

    xcb_flush(connection_);

    std::cout
        << "Janela decorada: " << client
        << " (moldura " << frame
        << ", barra " << titleBar << ")\n";

    return true;
}

void WindowManager::unmanageWindow(xcb_window_t client)
{
    const auto iterator = windows_.find(client);

    if (iterator == windows_.end()) {
        return;
    }

    const xcb_window_t frame = iterator->second.frame;

    if (focusedFrame_ == frame) {
        clearFocus();
    }

    xcb_reparent_window(
        connection_,
        client,
        screen_->root,
        0,
        0
    );

    xcb_destroy_window(connection_, frame);

    windows_.erase(iterator);

    xcb_flush(connection_);
}



void WindowManager::drawTitleBar(xcb_window_t titleBar)
{
    constexpr char title[] = "Eden Window";

    const auto geometryCookie = xcb_get_geometry(connection_, titleBar);

    xcb_generic_error_t* error = nullptr;
    xcb_get_geometry_reply_t* geometry =
        xcb_get_geometry_reply(connection_, geometryCookie, &error);

    std::free(error);

    if (geometry == nullptr) {
        return;
    }

    const ManagedWindow* managed = findByTitleBar(titleBar);
    const bool maximized = managed != nullptr && managed->maximized;
    const bool focused =
        managed != nullptr && managed->frame == focusedFrame_;

    const uint32_t backgroundColor = focused
        ? colorPixel(
              connection_,
              screen_->default_colormap,
              0x2F2F,
              0x6F6F,
              0x4E4E,
              screen_->black_pixel)
        : colorPixel(
              connection_,
              screen_->default_colormap,
              0x2A2A,
              0x2A2A,
              0x2A2A,
              screen_->black_pixel);

    const uint32_t buttonColor = focused
        ? colorPixel(
              connection_,
              screen_->default_colormap,
              0x2458,
              0x5C5C,
              0x4040,
              backgroundColor)
        : colorPixel(
              connection_,
              screen_->default_colormap,
              0x3A3A,
              0x3A3A,
              0x3A3A,
              backgroundColor);

    const uint32_t closeColor = focused
        ? colorPixel(
              connection_,
              screen_->default_colormap,
              0xCCCC,
              0x3333,
              0x3333,
              buttonColor)
        : colorPixel(
              connection_,
              screen_->default_colormap,
              0x6A6A,
              0x3A3A,
              0x3A3A,
              buttonColor);

    const uint32_t titleColor = focused
        ? screen_->white_pixel
        : colorPixel(
              connection_,
              screen_->default_colormap,
              0x8C8C,
              0x8C8C,
              0x8C8C,
              screen_->white_pixel);

    const xcb_gcontext_t gc = xcb_generate_id(connection_);

    const uint32_t values[] = {
        XCB_GX_COPY,
        backgroundColor,
        2,
        0
    };

    xcb_create_gc(
        connection_,
        gc,
        titleBar,
        XCB_GC_FUNCTION |
            XCB_GC_FOREGROUND |
            XCB_GC_LINE_WIDTH |
            XCB_GC_GRAPHICS_EXPOSURES,
        values
    );

    const xcb_rectangle_t rectangle = {
        0,
        0,
        geometry->width,
        geometry->height
    };

    xcb_poly_fill_rectangle(
        connection_,
        titleBar,
        gc,
        1,
        &rectangle
    );

    xcb_change_gc(
        connection_,
        gc,
        XCB_GC_FOREGROUND,
        &titleColor
    );

    xcb_image_text_8(
        connection_,
        sizeof(title) - 1,
        titleBar,
        gc,
        10,
        21,
        title
    );

    const TitleBarButtons buttons = titleBarButtons(geometry->width);

    xcb_change_gc(connection_, gc, XCB_GC_FOREGROUND, &buttonColor);
    fillButton(connection_, titleBar, gc, buttons.minimize);
    fillButton(connection_, titleBar, gc, buttons.maximize);

    xcb_change_gc(connection_, gc, XCB_GC_FOREGROUND, &closeColor);
    fillButton(connection_, titleBar, gc, buttons.close);

    xcb_change_gc(connection_, gc, XCB_GC_FOREGROUND, &titleColor);
    drawMinimizeGlyph(connection_, titleBar, gc, buttons.minimize);
    drawMaximizeGlyph(
        connection_,
        titleBar,
        gc,
        buttons.maximize,
        maximized);
    drawCloseGlyph(connection_, titleBar, gc, buttons.close);

    xcb_free_gc(connection_, gc);
    std::free(geometry);
    xcb_flush(connection_);
}

WindowManager::ManagedWindow* WindowManager::findByFrame(xcb_window_t frame)
{
    for (auto& [client, managed] : windows_) {
        (void)client;

        if (managed.frame == frame) {
            return &managed;
        }
    }

    return nullptr;
}

WindowManager::ManagedWindow*
WindowManager::findByTitleBar(xcb_window_t titleBar)
{
    for (auto& [client, managed] : windows_) {
        (void)client;

        if (managed.titleBar == titleBar) {
            return &managed;
        }
    }

    return nullptr;
}

void WindowManager::ensureAtoms()
{
    if (connection_ == nullptr ||
        (wmProtocols_ != XCB_ATOM_NONE &&
         wmDeleteWindow_ != XCB_ATOM_NONE &&
         wmTakeFocus_ != XCB_ATOM_NONE)) {
        return;
    }

    const auto protocolsCookie = xcb_intern_atom(
        connection_,
        0,
        12,
        "WM_PROTOCOLS");
    const auto deleteCookie = xcb_intern_atom(
        connection_,
        0,
        16,
        "WM_DELETE_WINDOW");
    const auto takeFocusCookie = xcb_intern_atom(
        connection_,
        0,
        13,
        "WM_TAKE_FOCUS");

    xcb_intern_atom_reply_t* protocols =
        xcb_intern_atom_reply(connection_, protocolsCookie, nullptr);
    xcb_intern_atom_reply_t* deleteWindow =
        xcb_intern_atom_reply(connection_, deleteCookie, nullptr);
    xcb_intern_atom_reply_t* takeFocus =
        xcb_intern_atom_reply(connection_, takeFocusCookie, nullptr);

    if (protocols != nullptr) {
        wmProtocols_ = protocols->atom;
        std::free(protocols);
    }

    if (deleteWindow != nullptr) {
        wmDeleteWindow_ = deleteWindow->atom;
        std::free(deleteWindow);
    }

    if (takeFocus != nullptr) {
        wmTakeFocus_ = takeFocus->atom;
        std::free(takeFocus);
    }
}

bool WindowManager::clientSupportsProtocol(
    xcb_window_t client,
    xcb_atom_t protocol)
{
    ensureAtoms();

    if (wmProtocols_ == XCB_ATOM_NONE || protocol == XCB_ATOM_NONE) {
        return false;
    }

    const auto cookie = xcb_get_property(
        connection_,
        0,
        client,
        wmProtocols_,
        XCB_ATOM_ATOM,
        0,
        32);

    xcb_get_property_reply_t* reply =
        xcb_get_property_reply(connection_, cookie, nullptr);

    if (reply == nullptr) {
        return false;
    }

    const auto* atoms = static_cast<const xcb_atom_t*>(
        xcb_get_property_value(reply));
    const int count =
        xcb_get_property_value_length(reply) /
        static_cast<int>(sizeof(xcb_atom_t));

    bool supports = false;

    for (int index = 0; index < count; ++index) {
        if (atoms[index] == protocol) {
            supports = true;
            break;
        }
    }

    std::free(reply);
    return supports;
}

bool WindowManager::clientAcceptsClose(xcb_window_t client)
{
    return clientSupportsProtocol(client, wmDeleteWindow_);
}

void WindowManager::focusWindow(ManagedWindow& window, xcb_timestamp_t time)
{
    const xcb_window_t previous = focusedFrame_;
    const bool changed = previous != window.frame;

    const uint32_t stackMode[] = {XCB_STACK_MODE_ABOVE};

    xcb_configure_window(
        connection_,
        window.frame,
        XCB_CONFIG_WINDOW_STACK_MODE,
        stackMode);

    xcb_set_input_focus(
        connection_,
        XCB_INPUT_FOCUS_POINTER_ROOT,
        window.client,
        time);

    if (clientSupportsProtocol(window.client, wmTakeFocus_)) {
        xcb_client_message_event_t message = {};
        message.response_type = XCB_CLIENT_MESSAGE;
        message.format = 32;
        message.window = window.client;
        message.type = wmProtocols_;
        message.data.data32[0] = wmTakeFocus_;
        message.data.data32[1] = time;

        xcb_send_event(
            connection_,
            0,
            window.client,
            XCB_EVENT_MASK_NO_EVENT,
            reinterpret_cast<const char*>(&message));
    }

    focusedFrame_ = window.frame;

    if (changed) {
        if (ManagedWindow* previousWindow = findByFrame(previous)) {
            drawTitleBar(previousWindow->titleBar);
        }

        drawTitleBar(window.titleBar);
    }

    xcb_flush(connection_);
}

void WindowManager::clearFocus()
{
    focusedFrame_ = XCB_WINDOW_NONE;

    if (!isConnected()) {
        return;
    }

    xcb_set_input_focus(
        connection_,
        XCB_INPUT_FOCUS_POINTER_ROOT,
        screen_->root,
        XCB_CURRENT_TIME);

    xcb_flush(connection_);
}

void WindowManager::closeWindow(ManagedWindow& window)
{
    if (draggingFrame_ == window.frame) {
        draggingFrame_ = XCB_WINDOW_NONE;
        xcb_ungrab_pointer(connection_, XCB_CURRENT_TIME);
    }

    if (!clientAcceptsClose(window.client)) {
        xcb_destroy_window(connection_, window.client);
        xcb_flush(connection_);
        return;
    }

    xcb_client_message_event_t message = {};
    message.response_type = XCB_CLIENT_MESSAGE;
    message.format = 32;
    message.window = window.client;
    message.type = wmProtocols_;
    message.data.data32[0] = wmDeleteWindow_;
    message.data.data32[1] = XCB_CURRENT_TIME;

    xcb_send_event(
        connection_,
        0,
        window.client,
        XCB_EVENT_MASK_NO_EVENT,
        reinterpret_cast<const char*>(&message));

    xcb_flush(connection_);
}

void WindowManager::minimizeWindow(ManagedWindow& window)
{
    if (draggingFrame_ == window.frame) {
        draggingFrame_ = XCB_WINDOW_NONE;
        xcb_ungrab_pointer(connection_, XCB_CURRENT_TIME);
    }

    if (focusedFrame_ == window.frame) {
        clearFocus();
    }

    xcb_unmap_window(connection_, window.frame);
    xcb_flush(connection_);
}

void WindowManager::layoutFrame(
    ManagedWindow& window,
    int16_t x,
    int16_t y,
    uint16_t width,
    uint16_t height)
{
    const uint32_t frameValues[] = {
        packedCoordinate(x),
        packedCoordinate(y),
        width,
        height
    };

    xcb_configure_window(
        connection_,
        window.frame,
        XCB_CONFIG_WINDOW_X |
            XCB_CONFIG_WINDOW_Y |
            XCB_CONFIG_WINDOW_WIDTH |
            XCB_CONFIG_WINDOW_HEIGHT,
        frameValues);

    const uint32_t titleBarValues[] = {
        0u,
        0u,
        width,
        kTitleBarHeight
    };

    xcb_configure_window(
        connection_,
        window.titleBar,
        XCB_CONFIG_WINDOW_X |
            XCB_CONFIG_WINDOW_Y |
            XCB_CONFIG_WINDOW_WIDTH |
            XCB_CONFIG_WINDOW_HEIGHT,
        titleBarValues);

    const uint16_t clientHeight =
        height > kTitleBarHeight
            ? static_cast<uint16_t>(height - kTitleBarHeight)
            : static_cast<uint16_t>(1);

    const uint32_t clientValues[] = {
        0u,
        kTitleBarHeight,
        width,
        clientHeight,
        0u
    };

    xcb_configure_window(
        connection_,
        window.client,
        XCB_CONFIG_WINDOW_X |
            XCB_CONFIG_WINDOW_Y |
            XCB_CONFIG_WINDOW_WIDTH |
            XCB_CONFIG_WINDOW_HEIGHT |
            XCB_CONFIG_WINDOW_BORDER_WIDTH,
        clientValues);

    const uint32_t stackMode[] = {XCB_STACK_MODE_ABOVE};

    xcb_configure_window(
        connection_,
        window.titleBar,
        XCB_CONFIG_WINDOW_STACK_MODE,
        stackMode);
}

void WindowManager::toggleMaximize(ManagedWindow& window)
{
    if (!isConnected()) {
        return;
    }

    if (window.maximized) {
        layoutFrame(
            window,
            window.restoreX,
            window.restoreY,
            window.restoreWidth,
            window.restoreHeight);

        window.maximized = false;
        xcb_flush(connection_);
        drawTitleBar(window.titleBar);
        return;
    }

    const auto cookie = xcb_get_geometry(connection_, window.frame);
    xcb_generic_error_t* error = nullptr;
    xcb_get_geometry_reply_t* geometry =
        xcb_get_geometry_reply(connection_, cookie, &error);

    std::free(error);

    if (geometry == nullptr) {
        return;
    }

    window.restoreX = geometry->x;
    window.restoreY = geometry->y;
    window.restoreWidth = geometry->width;
    window.restoreHeight = geometry->height;
    std::free(geometry);

    layoutFrame(
        window,
        0,
        0,
        screen_->width_in_pixels,
        screen_->height_in_pixels);

    window.maximized = true;
    xcb_flush(connection_);
    drawTitleBar(window.titleBar);
}

void WindowManager::handleMouseEvent(xcb_generic_event_t* event)
{
    const uint8_t type = event->response_type & 0x7f;

    if (type == XCB_BUTTON_PRESS) {
        const auto* button =
            reinterpret_cast<xcb_button_press_event_t*>(event);

        auto client = windows_.find(button->event);

        if (client == windows_.end() && button->child != XCB_WINDOW_NONE) {
            client = windows_.find(button->child);
        }

        if (client != windows_.end()) {
            focusWindow(client->second, button->time);

            xcb_allow_events(
                connection_,
                XCB_ALLOW_REPLAY_POINTER,
                button->time);
            xcb_flush(connection_);
            return;
        }

        if (ManagedWindow* frameWindow = findByFrame(button->event)) {
            focusWindow(*frameWindow, button->time);
            return;
        }

        ManagedWindow* window = findByTitleBar(button->event);

        if (window == nullptr) {
            return;
        }

        focusWindow(*window, button->time);

        if (button->detail != XCB_BUTTON_INDEX_1) {
            return;
        }

        const auto barCookie =
            xcb_get_geometry(connection_, window->titleBar);

        xcb_generic_error_t* barError = nullptr;

        xcb_get_geometry_reply_t* barGeometry =
            xcb_get_geometry_reply(
                connection_,
                barCookie,
                &barError
            );

        std::free(barError);

        if (barGeometry == nullptr) {
            return;
        }

        const TitleButton clicked = titleButtonAt(
            barGeometry->width,
            button->event_x,
            button->event_y
        );

        std::free(barGeometry);

        if (clicked != TitleButton::None) {
            switch (clicked) {
            case TitleButton::Minimize:
                minimizeWindow(*window);
                break;

            case TitleButton::Maximize:
                toggleMaximize(*window);
                break;

            case TitleButton::Close:
                closeWindow(*window);
                break;

            case TitleButton::None:
                break;
            }

            return;
        }

        const auto frameCookie =
            xcb_get_geometry(connection_, window->frame);

        xcb_generic_error_t* frameError = nullptr;

        xcb_get_geometry_reply_t* frameGeometry =
            xcb_get_geometry_reply(
                connection_,
                frameCookie,
                &frameError
            );

        std::free(frameError);

        if (frameGeometry == nullptr) {
            return;
        }

        draggingFrame_ = window->frame;
        dragStartX_ = button->root_x;
        dragStartY_ = button->root_y;
        frameStartX_ = frameGeometry->x;
        frameStartY_ = frameGeometry->y;

        std::free(frameGeometry);

        xcb_grab_pointer(
            connection_,
            0,
            window->titleBar,
            XCB_EVENT_MASK_BUTTON_RELEASE |
                XCB_EVENT_MASK_POINTER_MOTION,
            XCB_GRAB_MODE_ASYNC,
            XCB_GRAB_MODE_ASYNC,
            XCB_WINDOW_NONE,
            XCB_CURSOR_NONE,
            XCB_CURRENT_TIME
        );

        xcb_flush(connection_);
    } else if (
        type == XCB_MOTION_NOTIFY &&
        draggingFrame_ != XCB_WINDOW_NONE
    ) {
        const auto* motion =
            reinterpret_cast<xcb_motion_notify_event_t*>(event);

        const int16_t newX = static_cast<int16_t>(
            frameStartX_ + (motion->root_x - dragStartX_)
        );

        const int16_t newY = static_cast<int16_t>(
            frameStartY_ + (motion->root_y - dragStartY_)
        );

        const uint32_t values[] = {
            packedCoordinate(newX),
            packedCoordinate(newY)
        };

        xcb_configure_window(
            connection_,
            draggingFrame_,
            XCB_CONFIG_WINDOW_X | XCB_CONFIG_WINDOW_Y,
            values
        );

        xcb_flush(connection_);
    } else if (type == XCB_BUTTON_RELEASE) {
        draggingFrame_ = XCB_WINDOW_NONE;

        xcb_ungrab_pointer(
            connection_,
            XCB_CURRENT_TIME
        );

        xcb_flush(connection_);
    }
}



void WindowManager::handleEvent(xcb_generic_event_t* event)
{
    const uint8_t responseType = event->response_type & 0x7f;


    
    if (responseType == XCB_BUTTON_PRESS ||
        responseType == XCB_BUTTON_RELEASE ||
        responseType == XCB_MOTION_NOTIFY) {
        handleMouseEvent(event);
        return;
    }

    switch (responseType) {

    case XCB_MAP_REQUEST: {
        const auto* mapEvent =
            reinterpret_cast<xcb_map_request_event_t*>(event);
    
        if (!manageWindow(mapEvent->window)) {
            xcb_map_window(connection_, mapEvent->window);
            xcb_flush(connection_);
        }
    
        break;
    }

    case XCB_DESTROY_NOTIFY: {
        const auto* destroyEvent =
            reinterpret_cast<xcb_destroy_notify_event_t*>(event);

        const auto iterator = windows_.find(destroyEvent->window);

        if (iterator != windows_.end()) {
            if (draggingFrame_ == iterator->second.frame) {
                draggingFrame_ = XCB_WINDOW_NONE;
            }

            if (focusedFrame_ == iterator->second.frame) {
                clearFocus();
            }

            xcb_destroy_window(connection_, iterator->second.frame);
            windows_.erase(iterator);
            xcb_flush(connection_);
        }

        std::cout
            << "Janela destruída: "
            << destroyEvent->window << '\n';
        break;
    }

    case XCB_CONFIGURE_REQUEST: {
        const auto* configureEvent =
            reinterpret_cast<xcb_configure_request_event_t*>(event);

        const auto managed = windows_.find(configureEvent->window);

        if (managed != windows_.end() && managed->second.maximized) {
            break;
        }

        const uint16_t valueMask = configureEvent->value_mask;
        uint32_t values[] = {
            static_cast<uint32_t>(configureEvent->x),
            static_cast<uint32_t>(configureEvent->y),
            configureEvent->width,
            configureEvent->height,
            configureEvent->border_width,
            configureEvent->sibling,
            configureEvent->stack_mode
        };

        xcb_configure_window(
            connection_,
            configureEvent->window,
            valueMask,
            values
        );

        xcb_flush(connection_);

        std::cout
            << "Solicitação de configuração para janela: "
            << configureEvent->window << '\n';
        break;
    }

    case XCB_EXPOSE: {
        const auto* exposeEvent =
            reinterpret_cast<xcb_expose_event_t*>(event);
    
        if (exposeEvent->count == 0 &&
            findByTitleBar(exposeEvent->window) != nullptr) {
            drawTitleBar(exposeEvent->window);
        }
    
        break;
    }

    default:
        break;
    }
}
